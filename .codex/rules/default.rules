prefix_rule(pattern=["/usr/bin/bash", "-lc", "api_key=$(jq -r '.providers.deepseek.api_key' .data/config.json); jq -cs 'map(select(.agent == \"director\")) | .[-1] as $e | {model: $e.model, messages: ($e.request.messages | .[0].content += \"\\n\\nOMNISCIENT DIRECTOR CONTEXT:\\n- Private thoughts are visible to you as dramatic intent and subjective belief. Use them to govern timing, pressure, and physical consequences.\\n- A private thought is never itself a witnessed event or objective truth. Never quote, paraphrase, or reveal it through perception_events unless a later physical action makes it observable.\\n- Resolve the character action in its actual stated location before reconciling it with CURRENT SCENE; do not teleport a character to the scene merely because it is the canonical destination.\" | .[-1].content |= sub(\"HISTORY:\\\\n  Turn 1 \\\\| TYPE=action\"; \"HISTORY:\\n  Turn 1 | TYPE=thought [DIRECTOR-PRIVATE, perceived by nobody]: Nossa, estou atrasado, o evento já deve ter começado.\\n  Turn 1 | TYPE=action\")), max_tokens: 2048, response_format: {type: \"json_object\"}, thinking: {type: \"disabled\"}}' .data/sessions/c2e5107b/debug.jsonl | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $api_key\" -H 'Content-Type: application/json' --data-binary @- | jq '{content: .choices[0].message.content, finish_reason: .choices[0].finish_reason, usage}'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "api_key=$(jq -r '.providers.deepseek.api_key' .data/config.json); jq -cs 'map(select(.agent == \"director\")) | .[-1] as $e | {model: $e.model, messages: ($e.request.messages | .[0].content += \"\\n\\nOMNISCIENT DIRECTOR CONTEXT:\\n- You may read entries marked DIRECTOR-PRIVATE as subjective dramatic context. They are beliefs or intentions, never witnessed events or objective truth. Never quote, paraphrase, expose, or let another character react to them unless later observable evidence independently permits it.\\n- CAUSAL PRIORITY: always resolve the final speech or action in HISTORY first. A private thought may shape timing or pressure but must never replace, cancel, or distract from that action.\\n- When the final entry is an action, perception_events must include at least one observable physical outcome resolving that attempted action, using the acting character ID exactly as subject_id.\\n- Respect the action stated location. If it conflicts with CURRENT SCENE, reconcile through scene_change and scene_update; never teleport the actor to the canonical scene or narrate an unconfirmed arrival.\" | .[-1].content |= sub(\"HISTORY:\\\\n  Turn 1 \\\\| TYPE=action\"; \"HISTORY:\\n  Turn 1 | TYPE=thought [DIRECTOR-PRIVATE, SPEAKER=C1]: Nossa, estou atrasado, o evento já deve ter começado.\\n  Turn 1 | TYPE=action\")), max_tokens: 2048, response_format: {type: \"json_object\"}, thinking: {type: \"disabled\"}}' .data/sessions/c2e5107b/debug.jsonl | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $api_key\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
