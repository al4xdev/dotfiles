prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" -c 'select(.turn_number == 9 and .agent == \"director\" and .error == null) | .request | .messages[0].content |= (sub(\"\\\\nRULES:\"; \"\\n- ROUTING EXPERIMENT: When multiple present characters have a concrete reason to react, choose the full sequence now so they speak in order in this same beat. Prefer a short exchange over narration-only in a socially active moment. Return next_speakers as null only when no present character has any useful immediate reaction. Narration is rendered separately and is never a speaker.\\n\\nRULES:\") | gsub(\",\\\\\\\"Narrator\\\\\\\"\\\\]\"; \"]\") | sub(\"\\\\\\\"next_speakers\\\\\\\":\\\\{\\\\\\\"type\\\\\\\":\\\\\\\"array\\\\\\\"\"; \"\\\\\\\"next_speakers\\\\\\\":{\\\\\\\"type\\\\\\\":[\\\\\\\"array\\\\\\\",\\\\\\\"null\\\\\\\"]\")) | {model:$model, messages, max_tokens, response_format, thinking:{type:\"disabled\"}}' .data/sessions/c2e5107b/debug.jsonl | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq '{content: .choices[0].message.content, usage, error}'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" -c 'select(.turn_number == 9 and .agent == \"director\" and .error == null) | .request | .messages[0].content |= (sub(\"\\\\nRULES:\"; \"\\n- ROUTING EXPERIMENT: When multiple present characters have a concrete reason to react, choose the full sequence now so they speak in order in this same beat. Prefer a short exchange over narration-only in a socially active moment. Return next_speakers as null only when no present character has any useful immediate reaction. Narration is rendered separately and is never a speaker.\\n\\nRULES:\") | gsub(\",\\\\\\\"Narrator\\\\\\\"\\\\]\"; \"]\") | sub(\"\\\\\\\"next_speakers\\\\\\\":\\\\{\\\\\\\"type\\\\\\\":\\\\\\\"array\\\\\\\"\"; \"\\\\\\\"next_speakers\\\\\\\":{\\\\\\\"type\\\\\\\":[\\\\\\\"array\\\\\\\",\\\\\\\"null\\\\\\\"]\")) | {model:$model, messages, max_tokens, response_format, thinking:{type:\"disabled\"}}' .data/sessions/c2e5107b/debug.jsonl | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" -c 'select(.turn_number == 7 and .agent == \"director\" and .error == null) | .request | .messages[0].content |= sub(\"\\\\nReturn only one JSON object\"; \"\\nATTENTION AND STATUS (apply after scene blocking):\\n- RECENCY IS NOT IMPORTANCE. Resolve the final HISTORY action fairly, but do not make its actor the center of the scene merely because they initiated this beat. Never ignore or punish the action to compensate.\\n- Use the SMALLEST natural reaction queue. Route multiple characters only when each has an independent, immediate reason grounded in their own goal or duty, not merely to comment on the same arrival.\\n- Preserve status and ongoing business. An authority overseeing a public ceremony normally gives a late low-status student a brief institutional consequence (record the delay, order them into place, a cold look) and immediately advances the ceremony; they do not suspend proceedings for personal concern without concrete evidence of danger.\\n- Social disapproval may appear as terse dismissal, impatient looks, whispers, or loss of standing. Do not turn it into a group interrogation or make everyone orbit the late arrival.\\n\\nReturn only one JSON object\") | {model:$model, messages, max_tokens, response_format, thinking:{type:\"disabled\"}}' .data/sessions/e5a0ca6a/debug.jsonl | tail -1 | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '.scene' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-12:]' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:1200,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você é um observador dramático autônomo antes do Diretor de um roleplay POV. Examine o estado e descubra se existe uma consequência do mundo ou reação social que está madura mas pode ser esquecida. Não escreva prosa nem falas, não controle o protagonista, não transforme a ação mais recente automaticamente no centro e não repita o que já aconteceu. Retorne JSON: {hint: string|null, reason: string, confidence: number}. O hint deve ser uma diretiva curta de acontecimento observável para o Diretor. Use null se a cena já estiver avançando naturalmente ou não houver consequência latente forte.\"},{role:\"user\",content:(\"CENA: \"+$scene+\"\\nHISTÓRICO RECENTE: \"+$history)}]}' | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '{location:.scene.location,time_of_day:.scene.time_of_day,audience:.scene.physical_facts.audience,selection_status:.scene.physical_facts.selection_status}' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-12:]' .data/sessions/e5a0ca6a/state.json)\" --arg cast \"$(jq -c '.characters | to_entries | map(select((.value.mind.personality | contains(\"Link\")) or .key == \"C1\") | {id:.key,name:.value.mind.name,personality:.value.mind.personality})' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:1600,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você é um observador de dinâmica dramática antes do Diretor de um roleplay POV. Detecte uma consequência social ou ambiental forte que já esteja preparada pela situação e pelas relações, mas ainda não aconteceu. Não escreva falas ou prosa, não controle Link, não repita uma reação já usada e não invente ligações. Pensamentos privados explicam pressão dramática, mas nenhum personagem os conhece. Retorne JSON {hint:string|null, reason:string, evidence:[string], rejected_alternatives:[string], confidence:number}. Cada afirmação do hint deve estar apoiada em evidence fornecida nos dados. Prefira o efeito social proporcional que envolva objetivos próprios dos coadjuvantes. Use null se não houver consequência latente forte.\"},{role:\"user\",content:(\"CENA PÚBLICA: \"+$scene+\"\\nHISTÓRICO ATÉ A AÇÃO ATUAL: \"+$history+\"\\nPERSONAGENS QUE POSSUEM RELAÇÃO EXPLÍCITA COM LINK: \"+$cast)}]}' | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '{location:.scene.location,time_of_day:.scene.time_of_day,audience:.scene.physical_facts.audience,selection_status:.scene.physical_facts.selection_status}' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-12:]' .data/sessions/e5a0ca6a/state.json)\" --arg cast \"$(jq -c '.characters | to_entries | map(select((.value.mind.personality | contains(\"Link\")) or .key == \"C1\") | {id:.key,name:.value.mind.name,profile_not_history:.value.mind.personality})' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:1800,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você simula pessoas numa cena de roleplay POV, não escreve roteiro. Pergunta central: se nenhum autor introduzir uma grande virada, quais microreações ocorreriam naturalmente nos próximos segundos? Perfis são disposições e relações, NÃO acontecimentos passados. História é somente o bloco HISTÓRICO. Pensamento privado não é percebido por outros. Primeiro avalie em silêncio cada presente por motivo imediato, custo social de reagir e intensidade provável. Depois retorne JSON {candidates:[{character_id:string,reaction_kind:string,pressure:number,why:string}], hint:string|null, reason:string, confidence:number}. candidates contém no máximo 5, ordenados por pressão. O hint é uma diretiva curta, sem falas ou prosa, que combina apenas as reações de alta pressão que coexistiriam. Pode incluir reação coletiva observável. Não controle Link, não crie revelação, perigo ou confronto maior. Use null se ninguém tiver pressão suficiente.\"},{role:\"user\",content:(\"CENA PÚBLICA: \"+$scene+\"\\nHISTÓRICO REAL ATÉ AGORA: \"+$history+\"\\nPERFIS E RELAÇÕES (possibilidades, não fatos ocorridos): \"+$cast)}]}' | curl -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '{location:.scene.location,time_of_day:.scene.time_of_day,audience:.scene.physical_facts.audience,selection_status:.scene.physical_facts.selection_status}' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-14:]' .data/sessions/e5a0ca6a/state.json)\" --arg cast \"$(jq -c '.characters | to_entries | map(select((.value.mind.personality | contains(\"Link\")) or .key == \"C1\") | {id:.key,name:.value.mind.name,profile_not_history:.value.mind.personality})' .data/sessions/e5a0ca6a/state.json)\" --arg participation \"$(jq -c '[.history[] | select(.turn_number >= 7 and (.content_type == \"speech\" or .content_type == \"action\")) | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | .speaker] | group_by(.) | map({speaker:.[0],recent_contributions:length})' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:1800,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você simula a continuidade social de uma cena de roleplay POV, não escreve roteiro. Identifique microreações que surgiriam sem intervenção autoral. Perfis são disposições, não história. Pensamentos privados não são conhecidos. Considere: motivo imediato, custo social, oportunidade pública, reação ainda não expressa e saturação recente. Quem já dominou vários beats recebe forte custo de repetição, salvo nova obrigação concreta. Quem permaneceu calado pode acumular pressão se a situação toca diretamente sua rivalidade, preconceito, proteção ou objetivo. Retorne JSON {candidates:[{character_id:string,reaction_kind:string,pressure:number,novelty:number,why:string}], hint:string|null, reason:string, confidence:number}. O hint combina somente reações simultâneas ou uma cadeia social natural, sem escrever falas, controlar Link, criar perigo ou grande virada. Reações coletivas e não verbais são válidas. Use null se nenhuma reação vencer o custo de repetição.\"},{role:\"user\",content:(\"CENA PÚBLICA: \"+$scene+\"\\nHISTÓRICO REAL: \"+$history+\"\\nPARTICIPAÇÃO RECENTE: \"+$participation+\"\\nPERFIS E RELAÇÕES: \"+$cast)}]}' | curl --max-time 35 -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '{location:.scene.location,time_of_day:.scene.time_of_day,audience:.scene.physical_facts.audience,selection_status:.scene.physical_facts.selection_status}' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-14:]' .data/sessions/e5a0ca6a/state.json)\" --arg cast \"$(jq -c '.characters | to_entries | map(select((.value.mind.personality | contains(\"Link\")) or .key == \"C1\") | {id:.key,name:.value.mind.name,profile_not_history:.value.mind.personality})' .data/sessions/e5a0ca6a/state.json)\" --arg participation \"$(jq -c '[.history[] | select(.turn_number >= 7 and (.content_type == \"speech\" or .content_type == \"action\")) | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | .speaker] | group_by(.) | map({speaker:.[0],recent_contributions:length})' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:2000,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você simula continuidade social emergente em roleplay POV, não escreve roteiro. Perfis são disposições, não história; somente HISTÓRICO ocorreu. Pensamentos privados não são percebidos. Modele motivo imediato, custo social, oportunidade pública, reação ainda não expressa e saturação recente. Depois modele contágio: uma microreação visível pode reduzir o custo para aliados, rivais ou espectadores socialmente alinhados; oposição também pode responder ao excesso. Não presuma contágio: derive-o das relações e da situação pública. Quem dominou beats recentes recebe custo forte salvo obrigação nova. Retorne JSON {seed_reactions:[{character_id:string,reaction:string,pressure:number,why:string}], propagation:[{from:string,to:string,effect:string,why:string}], hint:string|null, reason:string, confidence:number}. O hint é uma diretiva curta de evento emergente, pode combinar reação coletiva e resposta contrastante, mas não contém falas, prosa, ações de Link, perigo ou grande virada. Use null se a cadeia não superar o custo social.\"},{role:\"user\",content:(\"CENA PÚBLICA: \"+$scene+\"\\nHISTÓRICO REAL: \"+$history+\"\\nPARTICIPAÇÃO RECENTE: \"+$participation+\"\\nPERFIS E RELAÇÕES: \"+$cast)}]}' | curl --max-time 35 -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "jq -n --arg model \"$(jq -r '.providers.deepseek.model' .data/config.json)\" --arg scene \"$(jq -c '{location:.scene.location,time_of_day:.scene.time_of_day,audience:.scene.physical_facts.audience,selection_status:.scene.physical_facts.selection_status}' .data/sessions/e5a0ca6a/state.json)\" --arg history \"$(jq -c '[.history[] | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | {turn_number,speaker,content_type,content}] | .[-14:]' .data/sessions/e5a0ca6a/state.json)\" --arg cast \"$(jq -c '.characters | to_entries | map(select((.value.mind.personality | contains(\"Link\")) or .key == \"C1\") | {id:.key,name:.value.mind.name,profile_not_history:.value.mind.personality})' .data/sessions/e5a0ca6a/state.json)\" --arg participation \"$(jq -c '[.history[] | select(.turn_number >= 7 and (.content_type == \"speech\" or .content_type == \"action\")) | select(.turn_number < 10 or (.turn_number == 10 and .speaker == \"Player\")) | .speaker] | group_by(.) | map({speaker:.[0],recent_contributions:length})' .data/sessions/e5a0ca6a/state.json)\" '{model:$model,max_tokens:2000,response_format:{type:\"json_object\"},thinking:{type:\"disabled\"},messages:[{role:\"system\",content:\"Você simula continuidade social emergente em roleplay POV, não escreve roteiro. Perfis são disposições, não história; somente HISTÓRICO ocorreu. Pensamentos privados não são percebidos. Modele motivo imediato, custo social, oportunidade pública, reação ainda não expressa e saturação recente. Modele contágio: uma microreação pode reduzir o custo para personagens socialmente alinhados, e oposição pode responder ao excesso. Quem dominou beats recentes recebe custo forte salvo obrigação nova. Retorne JSON {atoms:[{event:string,support:[string],strength:number}], rejected:[{event:string,reason:string}], hint:string|null, reason:string, confidence:number}. RESTRIÇÃO DE EVIDÊNCIA: cada fato do hint deve aparecer em atoms e citar suporte literal dos dados. Um grupo anônimo pode apenas ter reação genérica compatível com a descrição explícita da audiência; ações específicas pertencem somente a personagens nomeados cujo perfil as sustente. Não invente objetos, registros, rumores, falas ou conhecimentos. O hint deve ser uma diretiva curta, sem prosa, falas, ações de Link, perigo ou grande virada. Use null se os átomos sustentados não formarem consequência útil.\"},{role:\"user\",content:(\"CENA PÚBLICA: \"+$scene+\"\\nHISTÓRICO REAL: \"+$history+\"\\nPARTICIPAÇÃO RECENTE: \"+$participation+\"\\nPERFIS E RELAÇÕES: \"+$cast)}]}' | curl --max-time 35 -fsS https://api.deepseek.com/chat/completions -H \"Authorization: Bearer $(jq -r '.providers.deepseek.api_key' .data/config.json)\" -H 'Content-Type: application/json' --data-binary @- | jq -r '.choices[0].message.content'"], decision="allow")
