{
  "plugins": {
    "chrome-devtools-plugin": {
      "enabled": true
    },
    "deliberative-harness": {
      "enabled": true
    }
  },
  "userSettings": {
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_EAGER",
    "browserJsExecutionPolicy": "BROWSER_JS_EXECUTION_POLICY_TURBO",
    "cliRemoteControlHostname": "alex-arc-desktop-drifting-ray",
    "customThemeSeedsLight": {
      "background": "#EAECF0",
      "foregroundOverride": "#4C4F69",
      "primary": "#8839EF"
    },
    "enableTerminalSandbox": false,
    "globalPermissionGrants": {
      "allow": [
        "command(*)",
        "read_file(*)",
        "write_file(*)",
        "read_url(*)",
        "mcp(*)",
        "execute_url(127.0.0.1)",
        "execute_url(localhost)",
        "execute_url(file:///home/alex/git/my/bey_a/index.html)"
      ],
      "deny": [
        "command(rm)",
        "command(rm -rf)",
        "write_file(/etc)"
      ]
    },
    "remoteControlEnabled": true,
    "remoteControlHostname": "alex-arc-desktop-polar-photon",
    "themeMode": "THEME_MODE_DARK",
    "useAiCredits": false
  }
}