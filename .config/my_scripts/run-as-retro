#!/usr/bin/env python3
import sys
import os
import pty
import select
import subprocess
import termios
import tty

def main():
    if len(sys.argv) < 2:
        print("Usage: run-as-retro <command> [args...]")
        sys.exit(1)
        
    # 1. Prepare Wayland socket permissions
    wayland_display = os.environ.get("WAYLAND_DISPLAY")
    xdg_runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if wayland_display and xdg_runtime_dir:
        socket_path = os.path.join(xdg_runtime_dir, wayland_display)
        if os.path.exists(socket_path):
            try:
                # Grant read/write permissions to everyone on the Wayland socket
                # so the 'retro' user can access it.
                os.chmod(socket_path, 0o666)
            except Exception as e:
                print(f"Warning: Failed to chmod Wayland socket: {e}", file=sys.stderr)
                
    # 2. Allow local user 'retro' on X11 if display is active
    if os.environ.get("DISPLAY"):
        try:
            subprocess.run(["xhost", "+si:localuser:retro"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    # 3. Build command to run
    cmd_to_run = " ".join(sys.argv[1:])
    
    # We create a secure runtime directory owned by retro and symlink alex's Wayland socket inside it
    setup_cmd = "mkdir -p /tmp/retro-runtime && chmod 700 /tmp/retro-runtime"
    if wayland_display and xdg_runtime_dir:
        socket_path = os.path.join(xdg_runtime_dir, wayland_display)
        setup_cmd += f" && ln -sf {socket_path} /tmp/retro-runtime/{wayland_display}"

    env_vars = f"WAYLAND_DISPLAY={wayland_display or ''} DISPLAY={os.environ.get('DISPLAY','')} XDG_RUNTIME_DIR=/tmp/retro-runtime PULSE_SERVER=unix:/run/user/1000/pulse/native"
    su_cmd = ["su", "retro", "-c", f"{setup_cmd} && cd /home/retro && env {env_vars} {cmd_to_run}"]

    # 4. Spawn su using pty to automate password input
    old_tty = None
    try:
        old_tty = termios.tcgetattr(sys.stdin.fileno())
    except termios.error:
        pass

    master_fd, slave_fd = pty.openpty()
    
    pid = os.fork()
    if pid == 0:
        # Child process
        os.setsid()
        os.dup2(slave_fd, 0)
        os.dup2(slave_fd, 1)
        os.dup2(slave_fd, 2)
        os.close(master_fd)
        os.close(slave_fd)
        os.execvp("su", su_cmd)
    else:
        # Parent process
        os.close(slave_fd)
        
        buf = b""
        password_sent = False
        
        # Set raw mode on stdin to pass all control characters properly
        if old_tty:
            tty.setraw(sys.stdin.fileno())
            
        try:
            while True:
                # Wait for activity on master_fd or stdin
                r, w, x = select.select([master_fd, sys.stdin.fileno()], [], [])
                
                if master_fd in r:
                    try:
                        data = os.read(master_fd, 1024)
                    except OSError:
                        break
                    if not data:
                        break
                    
                    if not password_sent:
                        buf += data
                        if b"Password" in buf or b"Senha" in buf or b"password" in buf or b"senha" in buf:
                            # Send password
                            os.write(master_fd, b"123\n")
                            password_sent = True
                            buf = b""
                            continue
                    
                    # Write to stdout
                    sys.stdout.buffer.write(data)
                    sys.stdout.buffer.flush()
                    
                if sys.stdin.fileno() in r:
                    data = os.read(sys.stdin.fileno(), 1024)
                    if not data:
                        break
                    os.write(master_fd, data)
        finally:
            # Restore tty settings
            if old_tty:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_tty)
            os.close(master_fd)

if __name__ == "__main__":
    main()
