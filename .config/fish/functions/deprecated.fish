function commits_help
    echo "Summary of common commit prefixes:"
    echo "- \`fix\`: For bug fixes."
    echo "- \`feat\`: For new features."
    echo "- \`docs\`: For documentation changes."
    echo "- \`style\`: For formatting changes that do not affect the code's meaning (spaces, formatting, semicolons, etc.)."
    echo "- \`refactor\`: For code refactoring that does not fix a bug nor add a feature."
    echo "- \`test\`: For adding or fixing tests."
    echo "- \`chore\`: For maintenance tasks such as dependency updates, build configurations, or code cleanup."
end
