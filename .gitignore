## ~/.gitignore

## Ignore absolutely everything by default
*

## Allow global configuration folders exception
!/.config/
/.config/*

## Fish specific rules
!/.config/fish/
!/.config/fish/config.fish
!/.config/fish/functions/
!/.config/fish/functions/**
!/.config/fish/completions/
!/.config/fish/completions/**
!/.config/fish/conf.d/
!/.config/fish/conf.d/**

## Micro specific rules (Everything except buffers)
!/.config/micro/
.config/micro/buffers/

## Alacritty specific rules (Everything)
!/.config/alacritty/
!/.config/alacritty/**

## Kitty specific rules (Everything)
!/.config/kitty/
!/.config/kitty/**

## Loose System and Terminal configurations
!/.bashrc
!/.config/starship.toml
!/.config/mimeapps.list

## Claude CLI specific rules (Only skills and CLAUDE.md)
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/skills/**
!/.claude/CLAUDE.md

## Gemini/Antigravity specific rules (Only GEMINI.md and config/config.json)
!/.gemini/
/.gemini/*
!/.gemini/config/
!/.gemini/config/config.json
!/.gemini/config/AGENTS.md

## Pi coding agent specific rules
!/.pi/
/.pi/*
!/.pi/agent/
/.pi/agent/*
!/.pi/agent/AGENTS.md
!/.pi/agent/settings.json
!/.pi/agent/keybindings.json
!/.pi/agent/grammar-fix.json
!/.pi/agent/trust.json
!/.pi/agent/mcp.json
!/.pi/agent/extensions/
!/.pi/agent/extensions/grammar-fix.ts
!/.pi/agent/extensions/interactive-shell.ts
!/.pi/agent/extensions/questionnaire.ts
!/.pi/agent/extensions/rename.ts
!/.pi/agent/extensions/structured-output.ts
!/.pi/agent/permission-mode/
!/.pi/agent/permission-mode/permission-mode.json

## Personal scripts
!/.config/my_scripts/
!/.config/my_scripts/**

## VS Code specific rules (settings, keybindings, prompts only — no extensions/state)
!/.config/Code/
/.config/Code/*
!/.config/Code/User/
/.config/Code/User/*
!/.config/Code/User/settings.json
!/.config/Code/User/keybindings.json
!/.config/Code/User/prompts/
!/.config/Code/User/prompts/**

## Dotfiles repository files
!.gitignore
!README.md

## Explicitly ignored (models.json has API keys)
.pi/agent/models.json

## SAFETY LOCKS (Ensure these never go to Git)
.config/fish/fish_variables
.config/fish/fish_history
.claude/settings.json
.claude/history.jsonl
.config/my_scripts/.keyring-unlock.log
.config/my_scripts/__pycache__/
.config/my_scripts/.claude/
