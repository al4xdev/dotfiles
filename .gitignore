## ~/.gitignore

## Ignore absolutely everything by default
*

## Allow global configuration folders exception
!/.config/
/.config/*

## Fish specific rules
!/.config/fish/
!/.config/fish/config.fish
!/.config/fish/cage-session.fish
!/.config/fish/functions/
!/.config/fish/functions/**
!/.config/fish/completions/
!/.config/fish/completions/**
!/.config/fish/conf.d/
!/.config/fish/conf.d/**

## Micro specific rules (Everything except buffers)
!/.config/micro/
.config/micro/buffers/

## Alacritty specific rules (Everything)
!/.config/alacritty/
!/.config/alacritty/**

## Kitty specific rules (Everything)
!/.config/kitty/
!/.config/kitty/**

## Loose System and Terminal configurations
!/.bashrc
!/.config/starship.toml

## Claude CLI specific rules (Only skills and CLAUDE.md)
!/.claude/
/.claude/*
!/.claude/skills/
!/.claude/skills/**
!/.claude/CLAUDE.md

## Gemini/Antigravity specific rules
!/.gemini/
/.gemini/*
!/.gemini/grammar-fix.json
!/.gemini/config/
/.gemini/config/*
!/.gemini/config/config.json
!/.gemini/config/AGENTS.md
!/.gemini/config/mcp_config.json
!/.gemini/config/hooks.json
!/.gemini/config/agents/
!/.gemini/config/agents/**

## Codex configuration (exclude credentials, state, caches, binaries, and managed skills)
!/.codex/
/.codex/*
!/.codex/config.toml
!/.codex/AGENTS.md
!/.codex/rules/
!/.codex/rules/**
!/.codex/custom/
!/.codex/custom/agy-scout/
!/.codex/custom/agy-scout/**
/.codex/custom/agy-scout/.agy-runs/
/.codex/custom/agy-scout/.venv/
/.codex/custom/agy-scout/*.egg-info/
/.codex/custom/agy-scout/.pytest_cache/
/.codex/custom/agy-scout/.mypy_cache/
/.codex/custom/agy-scout/.ruff_cache/
/.codex/custom/agy-scout/**/__pycache__/
/.codex/custom/agy-scout/**/*.pyc

## Shared agent skills
!/.agents/
/.agents/*
!/.agents/skills/
!/.agents/skills/**

## DSH (DeepSeek Harness) specific rules
## Hand-written agent config plus the profile wiring (providers, permissions,
## theme, shortcuts). The alex-* plugin rows inside cordis.patch.yml are
## generated by ~/git/my/rt/tools/activate.mjs, which rewrites them for
## whichever machine this repo lands on; the plugin sources are a separate repo.
!/.dsh/
/.dsh/*
!/.dsh/AGENTS*.md
!/.dsh/.agent-presets/
/.dsh/.agent-presets/*
!/.dsh/.agent-presets/default/
/.dsh/.agent-presets/default/*
!/.dsh/.agent-presets/default/preset.yml
!/.dsh/.agent-presets/default/agent.cordis.yml
!/.dsh/profiles/
/.dsh/profiles/*
!/.dsh/profiles/*/
/.dsh/profiles/*/*
!/.dsh/profiles/*/cordis.patch.yml
!/.dsh/profiles/*/cordis.yml
!/.dsh/profiles/*/package.json
!/.dsh/profiles/*/standard-managed-plugins.yml
!/.dsh/profiles/*/alex-research-*.yml

## Personal scripts
!/.config/my_scripts/
!/.config/my_scripts/**

## VS Code specific rules (settings, keybindings, prompts only — no extensions/state)
!/.config/Code/
/.config/Code/*
!/.config/Code/User/
/.config/Code/User/*
!/.config/Code/User/settings.json
!/.config/Code/User/keybindings.json
!/.config/Code/User/prompts/
!/.config/Code/User/prompts/**

## Dotfiles repository files
!.gitignore
!README.md

## SAFETY LOCKS (Ensure these never go to Git)
.codex/auth.json
.config/fish/fish_variables
.config/fish/fish_history
.claude/settings.json
.claude/history.jsonl
.config/my_scripts/.keyring-unlock.log
.config/my_scripts/__pycache__/
.config/my_scripts/.claude/
.dsh/.credentials.yaml
.dsh/dsh-auth/credentials.json
.dsh/antigravity-oauth-client.json
.dsh/sessions/
.dsh/storages/
.dsh/attachments/
*.bak
*.bak.*
.claude/skills/synced/
.claude/skills/.trash/
.config/my_scripts/grammar-fix-editor.sh
.config/my_scripts/keyring-unlock-startup.py
.config/my_scripts/keyring-unlock-startup.sh
